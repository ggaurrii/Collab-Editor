# All optional in dev (defaults match docker-compose). Set real values in production.

# Shared by apps/web (signs sessions + WS tickets) and apps/realtime (verifies tickets).
# MUST be identical in both, and is required when NODE_ENV=production.
AUTH_SECRET=dev-secret-change-me

DATABASE_URL=postgres://collab:collab@localhost:5432/collab
REDIS_URL=redis://localhost:6379

# apps/web: comma-separated; each browser tab picks one at random
NEXT_PUBLIC_WS_URLS=ws://localhost:4000,ws://localhost:4001
